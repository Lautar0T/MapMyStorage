{
  "name": "real-disk-map",
  "title": "Real Disk Map",
  "description": "View real disk usage of files and folders, including cloud file detection",
  "icon": "disk-icon.png",
  "author": "lautaror",
  "license": "MIT",
  "categories": ["System", "Productivity"],
  "keywords": ["disk", "storage", "files", "usage", "size"],
  "version": "0.2.0",
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  },
  "dependencies": {
    "@raycast/api": "^1.69.0",
    "@raycast/utils": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2"
  },
  "preferences": [
    {
      "name": "defaultRootPath",
      "title": "Default Scan Path",
      "description": "The default path to scan when opening the extension",
      "type": "textfield",
      "required": false,
      "default": "~",
      "placeholder": "e.g., ~/Documents"
    },
    {
      "name": "showHiddenFiles",
      "title": "Show Hidden Files",
      "description": "Show hidden files by default",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Show hidden files"
    },
    {
      "name": "excludePatterns",
      "title": "Exclude Patterns",
      "description": "Comma-separated list of patterns to exclude from scans",
      "type": "textfield",
      "required": false,
      "default": ".git,node_modules,.DS_Store",
      "placeholder": "e.g., .git,node_modules"
    },
    {
      "name": "followSymlinks",
      "title": "Follow Symlinks",
      "description": "Follow symbolic links during scan",
      "type": "checkbox",
      "required": false,
      "default": false,
      "label": "Follow symlinks"
    },
    {
      "name": "maxScanDepth",
      "title": "Max Scan Depth",
      "description": "Maximum depth to scan (0 = unlimited)",
      "type": "textfield",
      "required": false,
      "default": "0",
      "placeholder": "e.g., 3"
    }
  ],
  "commands": [
    {
      "name": "scan",
      "title": "Scan Directory",
      "subtitle": "Real Disk Map",
      "description": "Scan a directory and show real disk usage",
      "mode": "view"
    },
    {
      "name": "quick-scan",
      "title": "Quick Scan",
      "subtitle": "Real Disk Map",
      "description": "Quickly scan a specific directory",
      "mode": "view",
      "arguments": [
        {
          "name": "path",
          "placeholder": "Path to scan",
          "type": "text",
          "required": false
        }
      ]
    }
  ]
}
